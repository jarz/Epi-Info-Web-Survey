<?xml version="1.0" encoding="utf-8"?>
<configuration>    
  <appSettings>
    
    <!-- Paste the admin key at sign-in; don't store it here. The Configuration page needs this deployment's key settings. -->
    <add key="AdminKey" value=""></add>
    <add key="KeyForConnectionStringPassphrase" value=""></add>
    <add key="KeyForConnectionStringSalt" value=""></add>
    <add key="KeyForConnectionStringVector" value=""></add>
    <add key="DataServiceSharedKey" value=""></add>
    <add key="Authentication_Use_Windows" value="FALSE"></add>
    <!--<add key="Authentication_Use_Windows" value="TRUE"></add>-->
   <add key="EndPointAddress" value="https://localhost:22587/Epi.Web.ServiceHost/SurveyManagerService.svc"></add>
    <!--<add key="EndPointAddress" value="https://dhap56ot.emergint.com/EIWS11/SurveyManagerService.svc"></add>-->
    <!--<add key="EndPointAddress" value="https://dhap56ot.emergint.com/EIWS12/SurveyManagerService.svc"></add>-->
     <!--<add key="EndPointAddress" value="https://localhost:22587/SurveyManagerService.svc"></add>-->

    <!--<add key="EndPointAddress" value="https://dhap56ot.emergint.com/EpiSurveyManager/SurveyManagerService.svc"></add>-->
    <!--<add key="EndPointAddress" value="https://dhap56ot.emergint.com/EpiSurveyManager_WS/SurveyManagerService.svc"></add>-->

    

    <add key="WCF_BINDING_TYPE" value="BASIC"></add>
    <!--<add key="WCF_BINDING_TYPE" value="WSHTTP"></add>-->
    <add key="SHOW_TESTING_FEATURES" value="FALSE"></add>
    <add key="maxBufferPoolSize" value="524288"></add>
    <add key="maxReceivedMessageSize" value="999999999"></add>
    <add key="maxDepth" value="32"></add>
    <add key="maxStringContentLength" value="2048000"></add>
    <add key="maxArrayLength" value="16384"></add>
    <add key="maxBytesPerRead" value="4096"></add>
    <add key="maxNameTableCharCount" value="16384"></add>
  
  </appSettings>
  <system.serviceModel>
    
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IManagerService">
          <security mode="Transport" />
        </binding>
        <binding name="BasicHttpBinding_IManagerServiceV2">
          <security mode="Transport" />
        </binding>
        <binding name="BasicHttpBinding_IManagerServiceV3">
          <security mode="Transport" />
        </binding>
        <binding name="BasicHttpBinding_IManagerServiceV4">
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="https://localhost:22587/Epi.Web.ServiceHost/SurveyManagerServiceV2.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IManagerServiceV2"
        contract="SurveyManagerServiceV2.IManagerServiceV2" name="BasicHttpBinding_IManagerServiceV2" />
      <endpoint address="https://localhost:22587/Epi.Web.ServiceHost/SurveyManagerServiceV3.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IManagerServiceV3"
        contract="SurveyManagerServiceV3.IManagerServiceV3" name="BasicHttpBinding_IManagerServiceV3" />
      <endpoint address="https://localhost:22587/Epi.Web.ServiceHost/SurveyManagerService.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IManagerService"
        contract="SurveyManagerService.IManagerService" name="BasicHttpBinding_IManagerService" />
      <endpoint address="https://localhost:22587/Epi.Web.ServiceHost/SurveyManagerServiceV4.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IManagerServiceV4"
        contract="SurveyManagerServiceV4.IManagerServiceV4" name="BasicHttpBinding_IManagerServiceV4" />
    </client>
  </system.serviceModel>
  

<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
